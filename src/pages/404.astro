---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" path="/404">
  <main>
    <article class="nf">
      <h1>Page not found</h1>
      <a class="nf-back nav-link" href="/">cd ..</a>
    </article>
  </main>
</Base>

<style>
  .nf { margin-top: clamp(40px, 8vw, 72px); }
  h1 {
    font-size: clamp(28px, 4.4vw, 40px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600;
    margin: 0 0 24px;
  }
  .nf-back { font: 13px var(--mono); color: var(--muted); text-decoration: none; }
  .nf-back:hover { color: var(--fg); }
</style>
