---
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  back: string;
  figure: [number, string];
  body: string[];
  pending: string;
  next?: { num: string; title: string; href: string };
  links?: { label: string; href: string }[];
  visuals?: Visual[];
}
// Inline visuals sit after the body paragraph with index `after`: a figure with a caption, or a strip of result callouts.
type Visual =
  | { after: number; figure: [number, string]; caption: string }
  | { after: number; stats: { value: string; label: string }[] };
const { title, description, path, back, figure, body, pending, next, links = [], visuals = [] } = Astro.props;
const paras = body.length ? body : [pending];
// Each block (paragraph or visual) rises in order after the hero.
const blocks = paras.flatMap((text, i) => [
  { text },
  ...(body.length ? visuals.filter((v) => v.after === i) : []),
]);
const delay = (i: number) => `--d:${(0.16 + i * 0.06).toFixed(2)}s`;
---
<Base title={title} description={description} path={path} figures>
  <main>
    <article class="dd">
      <a class="dd-back nav-link" href={back}>cd ..</a>
      <h1 class="rise-dd" style="--d:.06s">{title}</h1>
      <div class="dd-fig rise-dd" style="--d:.12s"><Figure kind={figure[0]} variant={figure[1]} /></div>
      <div class="dd-body">
        {blocks.map((b, i) =>
          'text' in b ? (
            <p class={`rise-dd${body.length ? '' : ' muted'}`} style={delay(i)}>{b.text}</p>
          ) : 'figure' in b ? (
            <figure class="dd-inline rise-dd" style={delay(i)}>
              <div class="dd-inline-fig"><Figure kind={b.figure[0]} variant={b.figure[1]} /></div>
              <figcaption>{b.caption}</figcaption>
            </figure>
          ) : (
            <dl class="dd-stats rise-dd" style={delay(i)}>
              {b.stats.map((s) => (
                <div class="dd-stat"><dt>{s.value}</dt><dd>{s.label}</dd></div>
              ))}
            </dl>
          )
        )}
      </div>
      {body.length > 0 && links.length > 0 && (
        <ul class="dd-links rise-dd" style={delay(blocks.length)}>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      )}
      <slot />
      <nav class="dd-nav" aria-label="Page navigation">
        <a class="dd-back nav-link" href={back}>cd ..</a>
        {next && (
          <a class="dd-next" href={next.href}>
            <span class="dd-next-num">cd ../{next.num}</span>
            <span>{next.title}</span>
          </a>
        )}
      </nav>
    </article>
  </main>
</Base>

<style>
  .dd { margin-top: clamp(40px, 8vw, 72px); }
  .dd-back { font: 13px var(--mono); color: var(--muted); text-decoration: none; }
  .dd-back:hover { color: var(--fg); }
  h1 {
    font-size: clamp(28px, 4.4vw, 40px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 600;
    margin: 40px 0 32px; text-wrap: balance;
  }
  .dd-fig {
    height: clamp(160px, 30vw, 240px); border: 1px solid var(--line); border-radius: 12px;
    background: var(--soft); padding: 20px; margin-bottom: 40px;
  }
  .dd-body { display: flex; flex-direction: column; gap: 22px; font-size: 18px; line-height: 1.7; }
  .dd-body p { margin: 0; }
  .dd-inline { margin: 12px 0; }
  .dd-inline-fig {
    height: clamp(140px, 24vw, 200px); border: 1px solid var(--line); border-radius: 12px;
    background: var(--soft); padding: 18px 22px;
  }
  .dd-inline figcaption { margin-top: 10px; font-size: 14px; line-height: 1.5; color: var(--muted); }
  .dd-stats {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); gap: 20px 28px;
    margin: 12px 0; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .dd-stat { display: flex; flex-direction: column; gap: 4px; }
  .dd-stat dt { font-size: clamp(26px, 3.6vw, 32px); line-height: 1.1; font-weight: 600; letter-spacing: -0.02em; }
  .dd-stat dd { margin: 0; font-size: 14px; line-height: 1.45; color: var(--muted); }
  .dd-links {
    list-style: none; margin: 32px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px 24px; font: 14px var(--mono);
  }
  .dd-links a { color: var(--fg); }
  .dd-links a:hover { color: var(--accent); }
  .dd-nav {
    margin-top: 64px; padding-top: 20px; border-top: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;
  }
  .dd-next {
    display: flex; flex-direction: column; align-items: flex-end; text-align: right;
    color: var(--fg); text-decoration: none; margin-left: auto;
  }
  .dd-next-num { font: 13px var(--mono); color: var(--muted); }
  .dd-next:hover, .dd-next:hover .dd-next-num { color: var(--accent); }
</style>
